{
  "name": "appshots",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '@appshots/web' dev",
    "dev:web": "bun run --filter '@appshots/web' dev",
    "dev:api": "bun run --filter '@appshots/api' dev",
    "build": "bun run --filter '@appshots/web' build",
    "test": "bun run --filter '*' test"
  }
}
