# ---- API (apps/api) ----
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appshots

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30

# Email delivery is deferred for v1: codes are logged to the server console.
# Set to a real provider (ses, etc.) in a later phase.
EMAIL_PROVIDER=console

# CORS: the web app origin (credentials enabled for the session cookie)
WEB_ORIGIN=http://localhost:5173

# Cloudflare R2 (only needed once image upload is used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=appshots
R2_PUBLIC_URL=

# ---- Web (apps/web) ----
# Create apps/web/.env with:
# VITE_API_URL=http://localhost:3000
